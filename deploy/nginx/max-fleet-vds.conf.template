# Public reverse proxy for the production Compose web service.
# Replace the two placeholders before installing this file on the VDS.
server {
    listen 80;
    listen [::]:80;
    server_name __MAX_FLEET_PUBLIC_HOSTNAME__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/max-fleet-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __MAX_FLEET_PUBLIC_HOSTNAME__;

    ssl_certificate /etc/letsencrypt/live/__MAX_FLEET_PUBLIC_HOSTNAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__MAX_FLEET_PUBLIC_HOSTNAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MAXFLEET:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 256k;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /health/ready {
        proxy_pass http://127.0.0.1:__MAX_FLEET_WEB_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health/live {
        proxy_pass http://127.0.0.1:__MAX_FLEET_WEB_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /max/webhook {
        access_log off;
        proxy_pass http://127.0.0.1:__MAX_FLEET_WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 35s;
    }

    location ^~ /api/v1/ {
        access_log off;
        proxy_pass http://127.0.0.1:__MAX_FLEET_WEB_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 20s;
    }

    location / {
        proxy_pass http://127.0.0.1:__MAX_FLEET_WEB_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
