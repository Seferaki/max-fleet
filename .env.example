DATA_MOCK_LISTEN_ADDR=:8000
DATA_MOCK_SNAPSHOT_FILE=
APP_ENV=development
LOG_LEVEL=info
COMPANY_TIMEZONE=Europe/Moscow
CONTRACT_VERSION=1.1
DATA_API_BASE_URL=http://data-mock:8000/internal/v1
MAX_UPDATE_MODE=disabled
MAX_INTEGRATION_KEY=demo-bot
MAX_PHOTO_HOSTS=
PUBLIC_BASE_URL=
MAX_BOT_TOKEN_FILE=
MAX_WEBHOOK_SECRET_FILE=
DATA_API_TOKEN_FILE=
WORKER_API_TOKEN_FILE=
DATABASE_URL_FILE=
MIGRATION_DATABASE_URL_FILE=
POSTGRES_PASSWORD_FILE=
S3_ENDPOINT=http://s3:8333
S3_BUCKET=max-fleet-photos
S3_REGION=us-east-1
S3_ACCESS_KEY_FILE=
S3_SECRET_KEY_FILE=
